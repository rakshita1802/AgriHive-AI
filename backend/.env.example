# =====================================================================
# AgriHive AI - Environment Secrets & Application Configuration
# =====================================================================
# Copy this file to `.env` in the backend root directory.
# DO NOT commit your production `.env` file to Git repository.

# --- Security Secrets ------------------------------------------------
SECRET_KEY=agrihive_production_super_secret_jwt_signature_key_2026_x89!
SECRET_SALT=agrihive_production_password_hash_salt_7731_#a

# --- CORS Allowed Domains -------------------------------------------
# Comma-separated origins for production frontend domains
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.agrihive.ai,https://agrihive.ai

# --- SMS OTP Gateway ------------------------------------------------
FAST2SMS_API_KEY=YOUR_FAST2SMS_PRODUCTION_API_KEY_HERE

# --- Database Connection --------------------------------------------
# Default: Local SQLite database
DATABASE_URL=sqlite:///./data/agrihive.db

# Managed PostgreSQL (Production Example):
# DATABASE_URL=postgresql+psycopg2://agrihive_user:SecurePassword123!@localhost:5432/agrihive_prod

# --- External APIs ---------------------------------------------------
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

HTTP_TIMEOUT_SECONDS=30
