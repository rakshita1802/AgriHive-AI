# Copy this file to .env and edit as needed.
# No Docker is required. By default AgriHive runs on a local SQLite file
# (agrihive.db) so it works immediately after `pip install -r requirements.txt`.
#
# To use PostgreSQL instead (optional), install PostgreSQL locally and set:
# DATABASE_URL=postgresql+psycopg2://agrihive:agrihive@localhost:5432/agrihive
DATABASE_URL=sqlite:///./data/agrihive.db

# NASA POWER API (historical weather) - no API key required
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Open-Meteo API (forecast + historical) - no API key required
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# SoilGrids REST API - no API key required
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

# HTTP client timeout (seconds) for outbound API calls
HTTP_TIMEOUT_SECONDS=30
